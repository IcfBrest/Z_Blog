# 复制为 deploy/.env 后按需修改：cp deploy/.env.example deploy/.env
# 复制出来的 .env 已被 .gitignore 排除，真实凭据不会进仓库。

# ── 站点 ────────────────────────────────────────────────
# 站点对外访问地址。本地保持 http://localhost:8090；
# 线上改成 https://<你的域名>，Caddy 会据此自动申请证书。
HALO_EXTERNAL_URL=http://localhost:8090

# 仅生产叠加层使用。未购买域名时可保留示例值，静态校验仍可通过。
DOMAIN=blog.example.com

# ── 数据库 ──────────────────────────────────────────────
POSTGRES_DB=halo
POSTGRES_USER=halo
# 首次部署前务必改成强密码；修改后需要重建数据库容器才能生效。
POSTGRES_PASSWORD=change-me-please

# ── 镜像版本 ────────────────────────────────────────────
# Halo 固定到补丁号以便复现问题；升级只改这里再 docker compose up -d。
HALO_IMAGE=registry.fit2cloud.com/halo/halo:2.27.0
POSTGRES_IMAGE=postgres:15
# 仅生产叠加层使用
CADDY_IMAGE=caddy:2-alpine

# ── 运行时 ──────────────────────────────────────────────
# 2C2G 机器上给 JVM 留出上限，同时避免一启动就占满内存。
JVM_OPTS="-Xmx512m -Xms256m"

# ── 备份上传（可选）─────────────────────────────────────
# 配置后，deploy/backup/backup.sh 会把本次两份产物作为参数交给该命令。
# 留空或注释掉则只保留本地产物。示例（腾讯云 COS，需另装 coscmd）：
# COS_UPLOAD_CMD=coscmd upload

